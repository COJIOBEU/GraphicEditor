<Window x:Class="GraphicEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Content="Карандаш" Width="80" Margin="2" Click="PencilButton_Click"/>
            <Button Content="Линия" Width="80" Margin="2" Click="LineButton_Click"/>
            <Button Content="Прямоугольник" Width="100" Margin="2" Click="RectButton_Click"/>
            <Button Content="Эллипс" Width="80" Margin="2" Click="EllipseButton_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Цвет:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="ColorComboBox" Width="100" SelectionChanged="ColorComboBox_SelectionChanged">
                <ComboBoxItem Content="Black" IsSelected="True"/>
                <ComboBoxItem Content="Red"/>
                <ComboBoxItem Content="Blue"/>
                <ComboBoxItem Content="Green"/>
                <ComboBoxItem Content="Yellow"/>
            </ComboBox>

            <TextBlock Text="Толщина:" VerticalAlignment="Center" Margin="15,0"/>
            <ComboBox x:Name="ThicknessComboBox" Width="60" SelectionChanged="ThicknessComboBox_SelectionChanged">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="3" IsSelected="True"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="7"/>
            </ComboBox>

            <Button Content="Отменить" Width="80" Margin="15,0,0,0" Click="UndoButton_Click"/>
            <Button Content="Очистить" Width="80" Margin="5,0,0,0" Click="ClearButton_Click"/>
            <Button Content="Сохранить" Width="80" Margin="5,0,0,0" Click="SaveButton_Click"/>
        </StackPanel>

        <Canvas x:Name="DrawingCanvas" Background="White" ClipToBounds="True" />
    </DockPanel>
</Window>